# Ambiente usado pelos testes (vitest). Não precisa de segredo real.
NODE_ENV=test
PORT=3334
HOST=0.0.0.0
LOG_LEVEL=silent
WEB_ORIGIN=http://localhost:5173

JWT_SECRET=test-only-secret-not-used-in-production-0000
JWT_EXPIRES_IN=7d

# Mesmo Postgres do docker-compose, banco separado.
DATABASE_URL=postgresql://uptime:uptime_secret@localhost:5433/uptime_monitor_test?schema=public
# Mesmo Redis do docker-compose, índice lógico separado do dev (0).
REDIS_URL=redis://localhost:6379/1

WORKER_CONCURRENCY=5
CHECK_DEFAULT_TIMEOUT_MS=5000
CHECK_LOG_RETENTION_DAYS=90
