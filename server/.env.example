# ─── App ─────────────────────────────────────────────
NODE_ENV=development
PORT=3333
HOST=0.0.0.0
LOG_LEVEL=info
# Origem do frontend (Vite) liberada no CORS
WEB_ORIGIN=http://localhost:5173

# ─── Auth ────────────────────────────────────────────
# Gere um valor forte: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ─── PostgreSQL (docker-compose: serviço "postgres") ─
DATABASE_URL=postgresql://uptime:uptime_secret@localhost:5433/uptime_monitor?schema=public

# ─── Redis (docker-compose: serviço "redis") ─────────
REDIS_URL=redis://localhost:6379

# ─── Worker ──────────────────────────────────────────
# Quantos pings HTTP o worker executa em paralelo
WORKER_CONCURRENCY=20
# Timeout padrão de cada request de checagem (ms)
CHECK_DEFAULT_TIMEOUT_MS=10000
# Dias de retenção dos CheckLogs (a página de status mostra 90 dias)
CHECK_LOG_RETENTION_DAYS=90
